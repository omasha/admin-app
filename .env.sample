# Copy to .env.local and fill in. Vite exposes only VITE_-prefixed vars.

# portal-api-v2 (no /api: these routes are under /v1)
VITE_API_URL="http://localhost:8000"

# Okta: the dev Okta. Either the portal's Okta app or one of its own; if its own, add its client
# ID to portal-api-v2's OKTA_EXTRA_CLIENT_IDS. In Okta, add http://localhost:3100/login/callback to
# the app's sign-in redirect URIs. No groups or extra token claims are needed.
VITE_OKTA_ISSUER="https://manicorn.burningman.org/oauth2/default"
VITE_OKTA_CLIENT_ID="<okta client id>"

# Refresh tokens: only once the Okta app has the "Refresh Token" grant turned on.
# VITE_OKTA_REFRESH_TOKENS="true"
